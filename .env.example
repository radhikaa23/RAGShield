# Required: replace with a random value of at least 32 characters; keep .env local.
RAGSHIELD_ACCESS_TOKEN=replace-with-a-long-random-token

# Optional hosted LLM. Without this, RAGShield returns a cited extractive answer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# RAG configuration. Sweep thresholds with `python -m app.evaluation`.
RAGSHIELD_CHUNK_SIZE=500
RAGSHIELD_CHUNK_OVERLAP=75
RAGSHIELD_TOP_K=5
RAGSHIELD_MAX_DISTANCE=0.72
RAGSHIELD_MAX_PDF_MB=20
RAGSHIELD_MAX_PDF_PAGES=300
RAGSHIELD_MAX_EXTRACTED_CHARS=5000000
RAGSHIELD_API_URL=http://127.0.0.1:8000
